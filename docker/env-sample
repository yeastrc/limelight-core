# .env file for supplying settings to initializing Limelight using docker-compose

# Change these passwords.
MYSQL_ROOT_PASSWORD=change_this_password
MYSQL_PASSWORD=change_this_password

# Can change the mysql user Limelight uses, but not necessary
MYSQL_USER=limelight_db_user

# This manages the memory usage of components of Limelight
IMPORTER_JAVA_OPTIONS=-Xmx3g -Xms500m
FEATURE_DETECTION_IMPORTER_JAVA_OPTIONS=-Xmx3g -Xms500m
WEBAPP_JAVA_OPTIONS=-Xms2024m -Xmx2024m

# The timeout in seconds for running Hardklor. If Hardklor runs for longer
# than this duration it will be terminated and an error generated
# Set to 0 to disable timeout
HARDKLOR_TIMEOUT=7200

# This manages optimization settings for MySQL
MYSQL_OPTIONS=--max-connections=500 --skip-ssl

# Settings for setting up sending of emails by Limelight
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp_username
SMTP_PASSWORD=smtp_password


#
# Optional config options. Uncomment and change value to change configuration
#

# Settings for spectr (spectral data storage and retrieval) service
# Setting to larger values may improve performance for function related to retrieving many
# spectra, but consume more resources
# SPECTR_MAX_SCAN_BATCH_SIZE=200

# Settings for .blib (Bibliospec spectral library export) service in Limelight
# yes = always delete working directory (default), no = never delete, "on success" = only delete on successful requests
# BLIB_APP_CLEAN_WORKDIR=yes

# The number of threads to use for simultaneous processing of scan files for exporting .blib spectral libraries
# Setting to a higher number will improve performance for multi-scan-file exports.
# MS2_MAX_THREADS=1

# Settings for feature detection service in Limelight
# yes = always delete working directory (default), no = never delete, "on success" = only delete on successful requests
# FEATURE_DETECTION_CLEAN_WORKDIR=yes

# Override the Limelight webapp's HttpSession inactivity timeout.
# Value is a positive integer number of MINUTES (e.g. 2880 for 48 hours).
# Leave unset/commented to use the Tomcat container's own default timeout
# (the stock Tomcat Docker image default is 30 minutes); Limelight does not set
# a session timeout of its own. An unset, blank, or invalid value applies no
# override. Larger values keep users logged in longer but increase server memory use.
# LIMELIGHT_SESSION_TIMEOUT_MINUTES=2880

# Sign-in limits.  Leave these unset/commented to use the defaults shown.
# LIMELIGHT_SIGNIN_LIMITS_ENABLED=false turns all of them off.
# Users already signed in are not affected.
#
# Turn all sign-in limits on (true, the default) or off (false):
# LIMELIGHT_SIGNIN_LIMITS_ENABLED=true
# Per username: number of wrong passwords that blocks that username:
# LIMELIGHT_SIGNIN_USER_MAX_FAILURES=7
# Per username: the window, in minutes, in which those wrong passwords are counted:
# LIMELIGHT_SIGNIN_USER_WINDOW_MINUTES=15
# Per username: how many minutes the username stays blocked:
# LIMELIGHT_SIGNIN_USER_BLOCK_MINUTES=8
# Seconds the user is asked to wait when a sign-in for the same username is in progress or too many are running:
# LIMELIGHT_SIGNIN_RETRY_SECONDS=30
# Maximum number of sign-ins processed at the same time:
# LIMELIGHT_SIGNIN_MAX_CONCURRENT=10
# Milliseconds a sign-in waits for a free slot before it is refused:
# LIMELIGHT_SIGNIN_CONCURRENT_WAIT_MILLIS=2000
# Alert only (an ERROR in the log, nothing is refused): number of failed sign-ins, all users together...
# LIMELIGHT_SIGNIN_ALERT_FAILURES=50
# ...within this many minutes:
# LIMELIGHT_SIGNIN_ALERT_WINDOW_MINUTES=5

#
# End Optional config options
#
