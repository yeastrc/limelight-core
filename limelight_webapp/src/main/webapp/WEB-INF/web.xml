<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" 
                             version="6.0">
                             
	<!-- Changed 'version' to '6.0' so that Eclipse WTP will accept it.  not recognize '6.1' -->

    <!-- Optional per-deployment HttpSession inactivity-timeout override via the
         env var LIMELIGHT_SESSION_TIMEOUT_MINUTES. Opt-in: when the env var is
         unset/blank/invalid, no override is applied and the Tomcat container's
         default session timeout applies. -->
    <listener>
        <listener-class>org.yeastrc.limelight.limelight_webapp.servlet_context_listener.HttpSession_InactivityTimeout_EnvVarOverride_Listener</listener-class>
    </listener>


    <error-page>
	    <!-- Page Not Found -->
	    <error-code>404</error-code>
        <location>/WEB-INF/jsp/generalError.jsp</location>
    </error-page>
    
    <!-- define global error handler -->
    <error-page>
        <location>/WEB-INF/jsp/generalError.jsp</location>
    </error-page>

</web-app>
